# Server-side secrets for Edge Functions. Never commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# AI provider (at least one). Groq is the default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional additional providers (OpenAI-compatible protocol)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Which provider is used unless a user picks another: groq | gemini | openai
AI_DEFAULT_PROVIDER=groq

# Cron / automation runner authentication (any long random string)
CRON_SECRET=

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Allowed browser origin(s) for CORS, comma separated. Use * only for local development.
ALLOWED_ORIGINS=http://localhost:5173
