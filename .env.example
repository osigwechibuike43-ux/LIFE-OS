# --- Frontend (public; safe to expose, protected by Row Level Security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional: enables web push subscription in the browser (public VAPID key)
VITE_VAPID_PUBLIC_KEY=

# --- Edge Function secrets (NEVER put these in frontend code) ---
# Set with: supabase secrets set --env-file supabase/functions/.env.example
# See supabase/functions/.env.example
